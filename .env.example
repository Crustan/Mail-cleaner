# Anthropic API key for the LLM layer (only called when rules can't decide)
ANTHROPIC_API_KEY=

# Model for the LLM layer. Default: claude-opus-5-5.
# claude-haiku-5-5 is ~40x cheaper if quality holds — measure first.
MAIL_CLEANER_MODEL=claude-opus-5-5

# Disable the LLM layer entirely (rules-only shadow run)
MAIL_CLEANER_NO_LLM=0
